{
  "name": "track-desktop",
  "productName": "Track Desktop",
  "version": "0.1.0",
  "description": "TrackOS live Windows desktop launcher and wallpaper.",
  "author": "Pama Technologies Ltd (based on the work of Rabiya Tahir)",
  "license": "MIT",
  "main": "src/track/main.js",
  "scripts": {
    "start": "electron .",
    "build:styles": "tailwindcss -i ./src/track/tailwind.css -o ./src/track/ui.css --minify",
    "prestart": "npm run build:styles",
    "predist": "npm run build:styles",
    "test": "node --test tests/track-logic.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "company.pama.track.desktop",
    "productName": "Track Desktop",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Track Desktop",
      "artifactName": "Track-Desktop-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "chrono-node": "^2.10.1",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.1",
    "node-ical": "^0.27.2"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
